<?xml version="1.0" encoding="utf-8"?>
<!-- Wave's player widget: the cover cut into a scalloped cookie shape, a pill with previous/next
     in the top corner, and a round play button over the bottom-left edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_open" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="7dp"
            android:background="@drawable/widget_ripple"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/ic_widget_previous" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:padding="7dp"
            android:background="@drawable/widget_ripple"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="18dp"
        android:background="@drawable/widget_play_circle"
        android:padding="20dp"
        android:contentDescription="@string/widget_play"
        android:src="@drawable/ic_widget_play" />
</FrameLayout>
