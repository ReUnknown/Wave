<Project Sdk="Microsoft.NET.Sdk">
  <!-- Wave for Windows, native: WinUI 3 (the system's own UI, drawn by the GPU through the
       compositor) and Windows' media player. Same look as everywhere else, a fraction of the
       memory and processor of the cross-platform build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Wave.App</RootNamespace>
    <AssemblyName>Wave</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWinUI>true</UseWinUI>
    <!-- The interface is built in code (no XAML files), so it also compiles off Windows. -->
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Builds Wave.pri, which points WinUI at its own control styles (with no XAML files the
         build would otherwise skip it, and WinUI can't find themeresources.xaml). -->
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- A plain app folder (no MSIX), carrying its own .NET and Windows App SDK. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wave.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Smaller and leaner: no globalization data, no unused Windows SDK projections loaded. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wave.Core\Wave.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
